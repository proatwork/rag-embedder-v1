# This machine's addresses, ports and keys, in one place. Copy this file to settings.env and change what differs:
#
#     cp settings.example.env settings.env && chmod 600 settings.env
#
# settings.env is not committed. A value in the environment wins over this file, and a script's own option
# (--server, --port, ...) wins over both. A line that starts with "#" is a comment; a name left empty keeps its default.
# How it is read: settings.py.

# The server that runs the embedding model (bge-m3), OpenAI-style: LM Studio, or llama-server.
# Default: http://127.0.0.1:1234 (LM Studio on this machine).
NORMS_EMBEDDING_SERVER=

# The server that runs the language model, for ask.py and the chatbot. Default: the embedding server.
NORMS_CHAT_SERVER=

# The language model's id on the chat server. Default: qwen/qwen3.8-27b
NORMS_CHAT_MODEL=

# The port the chatbot's page is served on (this machine only). Default: 8765
NORMS_CHATBOT_PORT=

# The port the MCP server listens on (this machine only). Default: 8766
NORMS_MCP_PORT=

# The key every request to the MCP server must carry: at least 32 plain characters. Make one, once, with
#     openssl rand -hex 16
# A new key means adding the server to Claude again. There is no default: without a key mcp_server.py does not start.
NORMS_MCP_KEY=

# The key of a hosted chat API, under any name you like; give ask.py that name with --chat-key-env MY_CHAT_KEY.
# MY_CHAT_KEY=
